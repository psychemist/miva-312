SECRET_KEY=replace-with-a-random-secret
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=pawkin
MYSQL_USER=pawkin
MYSQL_PASSWORD=choose-a-local-database-password
# Enable for hosted MySQL. Add a CA certificate in PEM format if required.
MYSQL_SSL=false
MYSQL_SSL_CA=
# Set true when serving behind HTTPS.
COOKIE_SECURE=false
